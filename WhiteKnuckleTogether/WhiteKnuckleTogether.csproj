<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <Nullable>enable</Nullable>
        <PackageId>WhiteKnuckleTogether</PackageId>
        <LangVersion>9</LangVersion>
    </PropertyGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="WhiteKnuckleTogether.Tests" />
    </ItemGroup>

    <ItemGroup>
      <!-- libopus for voice chat, built by tools/build-opus.ps1. Ships next to the mod DLL. -->
      <None Include="Native\opus.dll" CopyToOutputDirectory="PreserveNewest" Link="opus.dll" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Chat\badwords.txt" />
    </ItemGroup>

    <ItemGroup>
      <!-- Built by tools/build-bundles.ps1 from assets/WKTAssets. Ships next to the mod DLL. -->
      <None Include="Bundles\*.bundle" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    </ItemGroup>

